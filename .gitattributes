# Auto detect text files and perform LF normalization
* text=auto

# Force LF for shell scripts (avoid CRLF breaking bash on Linux/CI)
*.sh text eol=lf

# Force CRLF for Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# .NET / C#
*.cs text diff=csharp
*.razor text
*.csproj text
*.sln text eol=crlf

# Docs and config
*.md text
*.json text
*.yml text
*.yaml text
*.tf text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dll binary
*.exe binary
*.pdf binary
