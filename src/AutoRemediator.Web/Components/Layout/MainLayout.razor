@inherits LayoutComponentBase

<MudThemeProvider @bind-IsDarkMode="_isDark" Theme="AppTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <span class="ar-mark mx-2">◆</span>
        <MudText Typo="Typo.h6" Style="font-weight:650;letter-spacing:-.01em;">AutoRemediator</MudText>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ml-3 ar-mono" Color="Color.Default">test</MudChip>
        <MudSpacer />
        <MudIconButton Icon="@(_isDark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="@(() => _isDark = !_isDark)" title="Toggle light/dark" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
            <MudNavLink Href="/runs" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.History">Runs</MudNavLink>
            <MudNavLink Href="/dependency-map" Icon="@Icons.Material.Filled.Inventory2">Dependency Map</MudNavLink>
            <MudNavLink Href="/configuration" Icon="@Icons.Material.Filled.Settings">Configuration</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="px-6 pb-8" Style="padding-top: 88px;">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _isDark = true;
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
