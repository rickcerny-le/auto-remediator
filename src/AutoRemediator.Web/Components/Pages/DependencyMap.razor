@page "/dependency-map"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using AutoRemediator.Contracts.Dtos
@inject IHttpClientFactory HttpFactory

<PageTitle>Dependency Map</PageTitle>

<h1>Dependency Map</h1>
<p>Matched packages across configured repositories and whether they are outdated.</p>

<button class="btn btn-primary" data-testid="refresh-map" @onclick="LoadAsync" disabled="@_loading">
    @(_loading ? "Loading…" : "Refresh")
</button>

@if (_error is not null)
{
    <div class="alert alert-warning mt-3" data-testid="map-error">@_error</div>
}
else if (_map is null)
{
    <p class="mt-3"><em>Click Refresh to run analysis.</em></p>
}
else if (_map.Entries.Count == 0)
{
    <p class="mt-3" data-testid="map-empty">No matched packages found.</p>
}
else
{
    <table class="table mt-3" data-testid="map-table">
        <thead>
            <tr><th>Repository</th><th>Package</th><th>Current</th><th>Latest</th><th>Status</th></tr>
        </thead>
        <tbody>
            @foreach (var e in _map.Entries)
            {
                <tr class="@(e.Status == "Outdated" ? "table-warning" : null)">
                    <td>@e.RepositorySlug</td>
                    <td>@e.PackageId</td>
                    <td>@e.CurrentVersion</td>
                    <td>@e.LatestVersion</td>
                    <td>@e.Status</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private DependencyMapDto? _map;
    private bool _loading;
    private string? _error;

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var client = HttpFactory.CreateClient("api");
            _map = await client.GetFromJsonAsync<DependencyMapDto>("api/dependency-map");
        }
        catch (Exception ex)
        {
            _error = $"Failed to load dependency map: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}
