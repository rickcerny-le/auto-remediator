@page "/configuration"
@using System.Net.Http.Json
@using AutoRemediator.Contracts.Dtos
@inject IHttpClientFactory HttpFactory

<PageTitle>Configuration</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Configuration</MudText>

@if (_status is not null)
{
    <MudAlert Severity="Severity.Info" Class="mb-4" data-testid="config-status">@_status</MudAlert>
}

<MudPaper Class="pa-4 mb-6" Elevation="1" MaxWidth="720px">
    <MudText Typo="Typo.h6" GutterBottom="true">Targeting settings</MudText>
    <MudTextField @bind-Value="_patterns" Label="Package patterns (comma-separated)" Placeholder="Orion180.*" data-testid="patterns" Class="mb-2" />
    <MudTextField @bind-Value="_excludes" Label="Exclude patterns" Placeholder="Orion180.Legacy.*" Class="mb-2" />
    <MudTextField @bind-Value="_feeds" Label="Feeds" Placeholder="https://pkgs.dev.azure.com/Orion180/..." Class="mb-2" />
    <MudTextField @bind-Value="_ignore" Label="Ignore (globs, held from updates)" Placeholder="Orion180.Legacy.*" data-testid="ignore" Class="mb-2" />
    <div class="d-flex align-center gap-4 mb-3">
        <MudSelect @bind-Value="_strategy" Label="Strategy" Style="max-width: 200px;">
            <MudSelectItem Value="@("Patch")">Patch</MudSelectItem>
            <MudSelectItem Value="@("Minor")">Minor</MudSelectItem>
            <MudSelectItem Value="@("Major")">Major</MudSelectItem>
        </MudSelect>
        <MudSwitch @bind-Value="_allowPrerelease" Label="Allow pre-release" Color="Color.Primary" />
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSettingsAsync" data-testid="save-settings">Save settings</MudButton>
</MudPaper>

<MudText Typo="Typo.h6" GutterBottom="true">Managed repositories</MudText>
<MudTable Items="_repos" Dense="true" Hover="true" Class="mb-3" data-testid="repos-table">
    <HeaderContent>
        <MudTh>Organization</MudTh><MudTh>Project</MudTh><MudTh>Name</MudTh><MudTh>Branch</MudTh><MudTh>Enabled</MudTh><MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Organization">@context.Organization</MudTd>
        <MudTd DataLabel="Project">@context.Project</MudTd>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Branch">@context.TargetBranch</MudTd>
        <MudTd DataLabel="Enabled">@(context.Enabled ? "yes" : "no")</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context.Id))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>No repositories configured.</MudText></NoRecordsContent>
</MudTable>

<MudPaper Class="pa-4" Elevation="1" MaxWidth="900px">
    <div class="d-flex gap-2 align-end flex-wrap">
        <MudTextField @bind-Value="_newOrg" Label="organization" />
        <MudTextField @bind-Value="_newProject" Label="project" />
        <MudTextField @bind-Value="_newName" Label="repository" />
        <MudTextField @bind-Value="_newBranch" Label="branch" />
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="AddAsync" data-testid="add-repo">Add</MudButton>
    </div>
</MudPaper>

@code {
    private List<ManagedRepositoryDto>? _repos;
    private string? _status;

    private string _patterns = "";
    private string _excludes = "";
    private string _feeds = "";
    private string _ignore = "";
    private string _strategy = "Minor";
    private bool _allowPrerelease;

    private string _newOrg = "";
    private string _newProject = "";
    private string _newName = "";
    private string _newBranch = "main";

    protected override async Task OnInitializedAsync()
    {
        await LoadSettingsAsync();
        await LoadReposAsync();
    }

    private HttpClient Api => HttpFactory.CreateClient("api");

    private async Task LoadSettingsAsync()
    {
        try
        {
            var s = await Api.GetFromJsonAsync<TargetingSettingsDto>("api/settings");
            if (s is not null)
            {
                _patterns = string.Join(", ", s.Patterns);
                _excludes = string.Join(", ", s.Excludes);
                _feeds = string.Join(", ", s.Feeds);
                _ignore = string.Join(", ", s.Ignore);
                _strategy = s.Strategy;
                _allowPrerelease = s.AllowPrerelease;
            }
        }
        catch (Exception ex) { _status = $"Could not load settings: {ex.Message}"; }
    }

    private async Task LoadReposAsync()
    {
        try { _repos = await Api.GetFromJsonAsync<List<ManagedRepositoryDto>>("api/repositories") ?? []; }
        catch (Exception ex) { _status = $"Could not load repositories: {ex.Message}"; _repos = []; }
    }

    private async Task SaveSettingsAsync()
    {
        var dto = new TargetingSettingsDto(
            Split(_patterns), Split(_excludes), Split(_feeds), _strategy, Split(_ignore), _allowPrerelease);
        var response = await Api.PutAsJsonAsync("api/settings", dto);
        _status = response.IsSuccessStatusCode ? "Settings saved." : $"Save failed ({(int)response.StatusCode}).";
    }

    private async Task AddAsync()
    {
        var input = new ManagedRepositoryInput(_newOrg, _newProject, _newName, true, string.IsNullOrWhiteSpace(_newBranch) ? "main" : _newBranch);
        var response = await Api.PostAsJsonAsync("api/repositories", input);
        if (response.IsSuccessStatusCode)
        {
            _newOrg = _newProject = _newName = ""; _newBranch = "main";
            await LoadReposAsync();
        }
        else { _status = $"Add failed ({(int)response.StatusCode})."; }
    }

    private async Task DeleteAsync(Guid id)
    {
        await Api.DeleteAsync($"api/repositories/{id}");
        await LoadReposAsync();
    }

    private static List<string> Split(string csv) =>
        csv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
}
